# URL of the Rust backend. For Docker Compose this stays on the host URL
# because it is used by the browser, not by the Next.js server.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Same simple shared key as APP_API_KEY. This key is visible to browsers, so
# treat it as a lightweight gate for this personal dashboard, not as a secret.
NEXT_PUBLIC_APP_API_KEY=change-me-to-a-long-random-string
