# ─── Core ────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackathon_hunter
# Dedicated database used only by `cargo test`. The integration test truncates it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/hackathon_hunter_test
DB_MAX_CONNECTIONS=10
# Long random value. Required for PATCH/POST endpoints (x-api-key header).
APP_API_KEY=change-me-to-a-long-random-string
# Comma-separated browser origins allowed by CORS.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100
DASHBOARD_URL=http://localhost:3000

# ─── Discovery: SearXNG ──────────────────────────────────────────────────────
# Docker Compose overrides this with http://searxng:8080.
SEARXNG_URL=http://localhost:8081
SEARXNG_TIMEOUT_SECS=45
MAX_RESULTS_PER_QUERY=8
MAX_URLS_PER_RUN=30
# Optional semicolon-separated override of the built-in bilingual query list.
# SEARCH_QUERIES=黑客松 2026 报名;hackathon China 2026 registration

# ─── Extraction: 9router (OpenAI-compatible) ─────────────────────────────────
NINEROUTER_BASE_URL=https://api.9router.ai/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ollama
LLM_TIMEOUT_SECS=90
CONFIDENCE_THRESHOLD=0.6
MAX_TEXT_CHARS=16000

# ─── Scraping ────────────────────────────────────────────────────────────────
SCRAPE_TIMEOUT_SECS=20
SCRAPE_CONCURRENCY=4
EXTRACT_CONCURRENCY=2
DOMAIN_RATE_LIMIT_MS=1500
# Re-check a previously processed URL after this many hours (detects changes).
SOURCE_REFRESH_HOURS=72
USER_AGENT=Mozilla/5.0 (compatible; HackathonHunter/1.0; +https://github.com/hackathon-hunter)

# ─── Email: Resend ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Hackathon Hunter <digest@yourdomain.com>
# Comma-separated recipients supported.
EMAIL_TO=you@example.com
AUTO_SEND_EMAIL=true

# ─── Scheduling (six-field cron, seconds included) ───────────────────────────
CRON_SCHEDULE=0 0 8 * * *
CRON_TIMEZONE=Asia/Shanghai
